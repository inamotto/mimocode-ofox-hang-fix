+
+  test("default headerTimeout falls back to DEFAULT_OPENAI_HEADER_TIMEOUT when not set", () => {
+    // Mirrors provider.ts:1680 header timeout selection logic.
+    function pickHeaderTimeout(options: { headerTimeout?: unknown }): number | undefined {
+      const headerTimeout = options["headerTimeout"] ?? DEFAULT_OPENAI_HEADER_TIMEOUT
+      const headerTimeoutMs = headerTimeout === false ? undefined : headerTimeout
+      return typeof headerTimeoutMs === "number" ? headerTimeoutMs : undefined
+    }
+
+    expect(pickHeaderTimeout({})).toBe(DEFAULT_OPENAI_HEADER_TIMEOUT)
+    expect(pickHeaderTimeout({ headerTimeout: 60_000 })).toBe(60_000)
+    expect(pickHeaderTimeout({ headerTimeout: false })).toBeUndefined()
+    expect(pickHeaderTimeout({ headerTimeout: null })).toBe(DEFAULT_OPENAI_HEADER_TIMEOUT)
+  })
